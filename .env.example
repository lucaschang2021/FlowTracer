# FlowTracer Alpha v0.1 local development baseline.
FLOWTRACER_ENV=development
FLOWTRACER_LOG_LEVEL=INFO
FLOWTRACER_APP_VERSION=0.1.0
FLOWTRACER_API_HOST=0.0.0.0
FLOWTRACER_API_PORT=8000

# Docker Compose service credentials. Local development examples only.
# Never reuse these values for a shared or production environment.
POSTGRES_DB=flowtracer
POSTGRES_USER=flowtracer
POSTGRES_PASSWORD=flowtracer_local_only
DATABASE_URL=postgresql+asyncpg://flowtracer:flowtracer_local_only@postgres:5432/flowtracer

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Reserved for BE-5. Never commit a real provider key.
AI_API_KEY=
