# Copy values into the process environment. The application does not load .env implicitly.
FLOWTRACER_ENV=development
FLOWTRACER_LOG_LEVEL=INFO
FLOWTRACER_APP_VERSION=0.1.0
FLOWTRACER_API_HOST=0.0.0.0
FLOWTRACER_API_PORT=8000

# Local examples only. Never commit real credentials.
DATABASE_URL=postgresql+asyncpg://flowtracer:local-example-only@localhost:5432/flowtracer
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
JWT_SECRET=local-example-only-change-before-any-shared-deployment
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=flowtracer-api
JWT_AUDIENCE=flowtracer-desktop
AI_PROVIDER=fake
AI_MODEL=flowtracer-fake-v1
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
# Required only for AI_PROVIDER=openai_compatible. Use HTTPS outside explicit loopback tests.
# AI_BASE_URL=https://llm.example.com/v1
# AI_API_KEY=local-example-only
